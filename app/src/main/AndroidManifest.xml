<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NAS 同步：需要访问局域网内 http://NAS:端口 的同步服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 保养到期提醒：Android 13 起发通知需运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 关机重启后重新排定闹钟（AlarmManager 的闹钟不跨重启） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+ 的精确闹钟：没授权时自动退回「大致时间」，仍然会提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 拍照上传凭证走系统相机，不申请相机权限（由相机 App 自己授权） -->
    <!-- AI 对话按住说话：应用内识别需要本 App 录音权限（语音记账仍走系统识别器，无需权限） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- 语音记账：调系统语音识别（不申请录音权限，由识别器自己处理） -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- AI 按住说话：应用内 SpeechRecognizer 绑定识别服务（Android 11+ 需显式声明可见性） -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- 导出 CSV / PDF、分享凭证图：把 cache 里的文件以 content:// 交给其它 App -->
        <provider
            android:name=".ShareProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 全屏看凭证大图 -->
        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:theme="@style/ViewerTheme"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 定时提醒：闹钟到点发通知 -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zsonit.carcare.ALARM" />
            </intent-filter>
        </receiver>

        <!-- 开机/更新后重排闹钟并刷新小组件 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：下次保养倒计时 -->
        <receiver
            android:name=".CarWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>
