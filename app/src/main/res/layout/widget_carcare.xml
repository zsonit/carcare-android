<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件：玻璃卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="15dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="车管家 · 下次保养"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:textColor="#5C6B7E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/w_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="机油+机滤"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0B1A2B" />

        <TextView
            android:id="@+id/w_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="还有 12 天"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0A84FF" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="32,800 km"
        android:textSize="11sp"
        android:textColor="#5C6B7E" />
</LinearLayout>
